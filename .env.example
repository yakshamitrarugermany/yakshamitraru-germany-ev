# Supabase Postgres (EU Frankfurt)
# Transaction pooler (port 6543), used by the app at runtime
DATABASE_URL=""
# Session pooler (port 5432), used by Prisma migrations
DIRECT_URL=""

# Better Auth
BETTER_AUTH_SECRET=""
# Set for local dev (http://localhost:3000) and production (e.g. https://yakshamitraru.de).
# Leave unset on Vercel preview deployments to use VERCEL_BRANCH_URL / VERCEL_URL automatically.
BETTER_AUTH_URL=""

# Initial admin account seed (used by npm run create-admin)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Transactional email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
INQUIRY_NOTIFY_EMAIL=""
